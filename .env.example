# Alpaca market-data credentials for scripts/fetch_real_data.py
ALPACA_KEY=
ALPACA_SECRET=

# Alpaca paper trading account (preferred for agentic-live --execute)
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=

# Live-money trading is refused unless this is set to YES (in addition to
# passing --live and using real-money ALPACA_KEY/ALPACA_SECRET).
ALPACA_LIVE_CONFIRM=

# Groq API credentials (primary provider: ultra-low latency & high throughput)
GROQ_API_KEY=
# Optional aliases kept for backwards compatibility:
# GROQ_KEY=
# GROOQ_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter credentials (automatic failover provider when Groq rate limits or fails)
OPEN_ROUTER_KEY=
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter Free Models (comma-separated fallback chain)
# Defaults include: meta-llama/llama-3.3-70b-instruct:free, google/gemini-2.0-flash-exp:free,
# deepseek/deepseek-r1:free, qwen/qwen-2.5-coder-32b-instruct:free, meta-llama/llama-3.1-8b-instruct:free
MODEL_NAME=meta-llama/llama-3.3-70b-instruct:free
